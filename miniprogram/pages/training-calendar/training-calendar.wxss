.calendar-page {
  min-height: 100vh;
  padding: 0 28rpx calc(64rpx + env(safe-area-inset-bottom));
  color: #111111;
  background: #FFFFFF;
}

.calendar-nav {
  position: relative;
  margin: 0 -28rpx 30rpx;
  background: #FFFFFF;
}

.calendar-back {
  position: absolute;
  left: 16rpx;
  z-index: 2;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.calendar-back-mark {
  width: 24rpx;
  height: 24rpx;
  border-left: 5rpx solid #0A0A0A;
  border-bottom: 5rpx solid #0A0A0A;
  transform: rotate(45deg);
}

.calendar-nav-title {
  position: absolute;
  left: 160rpx;
  right: 160rpx;
  bottom: 8px;
  color: #111111;
  text-align: center;
  white-space: nowrap;
  font-size: 32rpx;
  font-weight: 700;
}

.calendar-card {
  padding: 36rpx 24rpx 30rpx;
  border: 1rpx solid #DADDE2;
  border-radius: 36rpx;
  background: #FFFFFF;
  box-shadow: 0 12rpx 30rpx rgba(33, 42, 52, 0.05);
}

.calendar-month-head {
  height: 64rpx;
  padding: 0 4rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.month-label {
  font-size: 34rpx;
  line-height: 1;
  font-weight: 900;
}

.month-control,
.month-control-placeholder {
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  min-width: 58rpx;
  max-width: 58rpx;
  flex-shrink: 0;
}

.month-control {
  margin: 0;
  padding: 0;
  border: 1rpx solid #DDE1E6;
  border-radius: 50%;
  background: #F8F9FA;
  display: flex;
  align-items: center;
  justify-content: center;
}

.month-control view {
  width: 14rpx;
  height: 14rpx;
  border-left: 3rpx solid #252A30;
  border-bottom: 3rpx solid #252A30;
  transform: rotate(45deg);
}

.month-control.next view {
  transform: rotate(225deg);
}

.month-control.disabled {
  opacity: 0.45;
}

.weekdays,
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
}

.weekday {
  height: 54rpx;
  color: #8A8E95;
  text-align: center;
  font-size: 24rpx;
  line-height: 54rpx;
  font-weight: 700;
}

.calendar-cell {
  height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.date-circle {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  color: #22272D;
  text-align: center;
  font-size: 26rpx;
  line-height: 60rpx;
  font-weight: 800;
}

.date-circle.energy {
  color: #FFFFFF;
  background: #F06F38;
}

.date-circle.energy,
.date-circle.cool,
.date-circle.mixed {
  box-shadow: 0 6rpx 12rpx rgba(37, 53, 68, 0.15);
}

.date-circle.cool {
  color: #FFFFFF;
  background: #258DE9;
}

.date-circle.mixed {
  color: #FFFFFF;
  background: linear-gradient(135deg, #F06F38 0%, #F06F38 49%, #258DE9 51%, #258DE9 100%);
}

.calendar-legend {
  margin: 28rpx 8rpx 0;
  display: flex;
  justify-content: center;
  gap: 34rpx;
}

.legend-item {
  color: #6B6F76;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.legend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}

.legend-dot.energy { background: #F06F38; }
.legend-dot.cool { background: #258DE9; }

.loading-text {
  margin-top: 42rpx;
  color: #8A8E95;
  text-align: center;
  font-size: 25rpx;
}
