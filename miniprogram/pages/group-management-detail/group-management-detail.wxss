.detail-page {
  min-height: 100vh;
  padding: 48rpx 28rpx 64rpx;
  background: #FFFFFF;
  color: #111111;
}

.page-heading { margin-bottom: 34rpx; }
.page-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 44rpx; line-height: 1.2; font-weight: 900; }
.group-id-row { min-width: 0; margin-top: 12rpx; display: flex; align-items: center; gap: 10rpx; color: #6B6F76; font-size: 25rpx; line-height: 1.2; }
.group-id-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.group-id-copy { width: 46rpx; height: 46rpx; flex: 0 0 46rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #F1F2F3; }
.group-id-copy:active { background: #E4E6E8; }
.copy-icon { position: relative; width: 26rpx; height: 26rpx; }
.copy-icon-back, .copy-icon-front { position: absolute; box-sizing: border-box; width: 18rpx; height: 18rpx; border: 2rpx solid #858A91; border-radius: 4rpx; background: #F1F2F3; }
.copy-icon-back { top: 2rpx; left: 2rpx; }
.copy-icon-front { right: 2rpx; bottom: 2rpx; }

.tabs {
  height: 88rpx;
  padding: 8rpx;
  border-radius: 28rpx;
  background: #F1F3F5;
  display: flex;
  gap: 8rpx;
}

.tab {
  border-radius: 22rpx;
  color: #6B6F76;
  font-size: 27rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
}

.tab.active { color: #258DE9; background: #FFFFFF; box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.08); }
.tab-panel { margin-top: 34rpx; }
.section-heading { margin-bottom: 22rpx; }
.section-title { font-size: 31rpx; line-height: 1.2; font-weight: 900; }
.section-copy { margin-top: 10rpx; color: #7B8088; font-size: 24rpx; }

.goal-list, .person-list { overflow: hidden; border: 1rpx solid #DADDE2; border-radius: 32rpx; background: #FBFBFC; }
.goal-card { min-height: 142rpx; padding: 24rpx 26rpx; border-bottom: 1rpx solid #E5E7EB; display: flex; align-items: center; gap: 18rpx; }
.goal-card:last-child, .person-row:last-child { border-bottom: 0; }
.goal-icon { width: 62rpx; height: 62rpx; border-radius: 21rpx; color: #258DE9; background: #EAF6FF; display: grid; place-items: center; flex-shrink: 0; }
.goal-icon .lucide-icon { width: 31rpx; height: 31rpx; }
.goal-content { min-width: 0; flex: 1; }
.goal-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 27rpx; font-weight: 900; }
.goal-description { margin-top: 8rpx; color: #6B6F76; font-size: 23rpx; }
.goal-action {
  box-sizing: border-box;
  width: 88rpx !important;
  min-width: 88rpx !important;
  max-width: 88rpx !important;
  height: 48rpx;
  min-height: 48rpx;
  max-height: 48rpx;
  margin: 0 0 0 auto;
  padding: 0 !important;
  border-radius: 15rpx;
  color: #FFFFFF;
  background: #258DE9;
  font-size: 21rpx;
  line-height: 48rpx;
  font-weight: 800;
  display: block;
  flex: 0 0 88rpx !important;
}
.goal-action.configured { color: #8B9097; background: #E5E7EB; }

.template-management-section { margin-top: 42rpx; }
.template-section-heading { margin-bottom: 22rpx; display: flex; align-items: center; justify-content: space-between; }
.all-templates-button { padding: 8rpx 0 8rpx 16rpx; color: #258DE9; font-size: 25rpx; font-weight: 800; display: flex; align-items: center; gap: 2rpx; }
.all-templates-button .lucide-icon { width: 25rpx; height: 25rpx; }
.managed-template-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24rpx 16rpx; }
.managed-template-item { min-width: 0; display: flex; flex-direction: column; align-items: center; }
.managed-template-icon { width: 112rpx; height: 112rpx; border: 1rpx solid #DADDE2; border-radius: 36rpx; display: grid; place-items: center; }
.managed-template-icon .lucide-icon { width: 43rpx; height: 43rpx; }
.managed-template-icon.energy { color: #F06F38; border-color: #F4B18C; background: #FFF0EA; box-shadow: 0 10rpx 24rpx rgba(240, 111, 56, .14); }
.managed-template-icon.vital { color: #44BF72; border-color: #9EE3B7; background: #EAF8EF; box-shadow: 0 10rpx 24rpx rgba(68, 191, 114, .14); }
.managed-template-icon.cool { color: #258DE9; border-color: #A8D8FF; background: #E9F4FF; box-shadow: 0 10rpx 24rpx rgba(37, 141, 233, .14); }
.managed-template-icon.gold { color: #D9A900; border-color: #F4DC7A; background: #FFF7D7; box-shadow: 0 10rpx 24rpx rgba(217, 169, 0, .14); }
.managed-template-icon.power { color: #D14AC7; border-color: #E9A8E2; background: #F8E9F6; box-shadow: 0 10rpx 24rpx rgba(209, 74, 199, .14); }
.managed-template-name { width: 100%; margin-top: 15rpx; overflow: hidden; text-align: center; text-overflow: ellipsis; white-space: nowrap; font-size: 23rpx; line-height: 1.2; font-weight: 800; }
.managed-template-empty { padding: 50rpx 24rpx; border: 1rpx dashed #DADDE2; border-radius: 28rpx; color: #7B8088; text-align: center; font-size: 25rpx; }

.person-row { min-height: 112rpx; padding: 18rpx 26rpx; border-bottom: 1rpx solid #E5E7EB; display: flex; align-items: center; gap: 18rpx; }
.person-avatar { width: 62rpx; height: 62rpx; border-radius: 50%; flex-shrink: 0; }
.avatar-fallback { color: #258DE9; background: #EAF6FF; font-size: 26rpx; font-weight: 900; display: grid; place-items: center; }
.person-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; font-size: 27rpx; font-weight: 800; }
.person-tag, .apply-tag { padding: 7rpx 13rpx; border-radius: 14rpx; font-size: 21rpx; line-height: 1.2; font-weight: 800; flex-shrink: 0; }
.person-tag { color: #6B6F76; background: #ECEEF1; }
.apply-tag { color: #258DE9; background: #EAF6FF; }
.member-remove-button {
  box-sizing: border-box;
  width: 88rpx !important;
  min-width: 88rpx !important;
  max-width: 88rpx !important;
  height: 48rpx;
  min-height: 48rpx;
  max-height: 48rpx;
  margin: 0 0 0 auto;
  padding: 0 !important;
  border: 1rpx solid #F6B3B3;
  border-radius: 15rpx;
  color: #E54D4D;
  background: #FFF5F5;
  font-size: 21rpx;
  line-height: 46rpx;
  font-weight: 800;
  display: block;
  flex: 0 0 88rpx !important;
}
.application-approve-button {
  box-sizing: border-box;
  width: 88rpx !important;
  min-width: 88rpx !important;
  max-width: 88rpx !important;
  height: 48rpx;
  min-height: 48rpx;
  max-height: 48rpx;
  margin: 0 0 0 auto;
  padding: 0 !important;
  border-radius: 15rpx;
  color: #FFFFFF;
  background: #258DE9;
  font-size: 21rpx;
  line-height: 48rpx;
  font-weight: 800;
  display: block;
  flex: 0 0 88rpx !important;
}
.loading-state, .empty-state { padding: 96rpx 24rpx; color: #7B8088; text-align: center; font-size: 27rpx; }
