.group-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 28rpx 26px;
  padding-top: calc(32rpx + env(safe-area-inset-top));
  background: #FFFFFF;
  color: #111111;
  display: flex;
  flex-direction: column;
}

.home-header {
  padding: 18rpx 0 42rpx;
}

.title {
  font-size: 48rpx;
  line-height: 1;
  font-weight: 900;
}

.section {
  margin-top: 20rpx;
  flex: 1;
}

.section-head {
  width: 100%;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.section-title {
  flex: 1;
  font-size: 30rpx;
  line-height: 1;
  font-weight: 900;
}

.all-button {
  margin-left: 0;
  margin-right: 0;
  flex-shrink: 0;
  color: #5E6269;
  font-size: 25rpx;
  line-height: 1;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.text-button-icon {
  width: 25rpx;
  height: 25rpx;
}

.group-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.group-card {
  min-height: 158rpx;
  padding: 28rpx 30rpx;
  border: 1rpx solid #DADDE2;
  border-radius: 38rpx;
  background: #F8F9FA;
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.group-icon {
  width: 94rpx;
  height: 94rpx;
  border-radius: 34rpx;
  display: grid;
  place-items: center;
  flex-shrink: 0;
}

.group-icon .lucide-icon {
  width: 42rpx;
  height: 42rpx;
}

.group-icon.energy {
  color: #F06F38;
  background: #FBE2D8;
}

.group-icon.cool {
  color: #258DE9;
  background: #DCEFFC;
}

.group-icon.vital {
  color: #44BF72;
  background: #DDF4E4;
}

.group-main {
  min-width: 0;
  flex: 1;
}

.group-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
  line-height: 1.18;
  font-weight: 900;
}

.group-meta {
  margin-top: 13rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #5E6269;
  font-size: 25rpx;
  line-height: 1;
  font-weight: 600;
}

.group-badge {
  max-width: 220rpx;
  padding: 7rpx 14rpx;
  border-radius: 20rpx;
  border: 1rpx solid currentColor;
  display: flex;
  align-items: center;
  gap: 5rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 21rpx;
  line-height: 1.1;
  font-weight: 900;
}

.badge-icon {
  width: 20rpx;
  height: 20rpx;
  flex-shrink: 0;
}

.group-badge.active {
  color: #44BF72;
  background: #DDF4E4;
}

.group-badge.calm {
  color: #258DE9;
  background: #EFF8FF;
}

.row-arrow {
  width: 34rpx;
  height: 34rpx;
  color: #5E6269;
  flex-shrink: 0;
}

.discover-button {
  margin-top: 40rpx;
  height: 108rpx;
  border: 1rpx solid #8AC5F7;
  border-radius: 36rpx;
  color: #1689F2;
  background: #EAF6FF;
  font-size: 30rpx;
  line-height: 1;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.discover-button .lucide-icon {
  width: 31rpx;
  height: 31rpx;
}
