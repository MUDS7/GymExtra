.group-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 28rpx 26px;
  padding-top: calc(32rpx + env(safe-area-inset-top));
  background: #FFFFFF;
  color: #111111;
  display: flex;
  flex-direction: column;
}

.home-header {
  padding: 18rpx 0 42rpx;
}

.title {
  font-size: 48rpx;
  line-height: 1;
  font-weight: 900;
}

.section {
  margin-top: 20rpx;
  flex: 1;
}

.section-head {
  width: 100%;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.section-title {
  flex: 1;
  font-size: 30rpx;
  line-height: 1;
  font-weight: 900;
}

.all-button {
  margin-left: 0;
  margin-right: 0;
  flex-shrink: 0;
  color: #5E6269;
  font-size: 25rpx;
  line-height: 1;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.text-button-icon {
  width: 25rpx;
  height: 25rpx;
}

.group-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.group-card {
  min-height: 158rpx;
  padding: 28rpx 30rpx;
  border: 1rpx solid #DADDE2;
  border-radius: 38rpx;
  background: #F8F9FA;
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.group-icon {
  width: 94rpx;
  height: 94rpx;
  border-radius: 34rpx;
  display: grid;
  place-items: center;
  flex-shrink: 0;
}

.group-icon .lucide-icon {
  width: 42rpx;
  height: 42rpx;
}

.group-icon.energy {
  color: #F06F38;
  background: #FBE2D8;
}

.group-icon.cool {
  color: #258DE9;
  background: #DCEFFC;
}

.group-icon.vital {
  color: #44BF72;
  background: #DDF4E4;
}

.group-main {
  min-width: 0;
  flex: 1;
}

.group-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
  line-height: 1.18;
  font-weight: 900;
}

.group-meta {
  margin-top: 13rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #5E6269;
  font-size: 25rpx;
  line-height: 1;
  font-weight: 600;
}

.group-badge {
  max-width: 220rpx;
  padding: 7rpx 14rpx;
  border-radius: 20rpx;
  border: 1rpx solid currentColor;
  display: flex;
  align-items: center;
  gap: 5rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 21rpx;
  line-height: 1.1;
  font-weight: 900;
}

.badge-icon {
  width: 20rpx;
  height: 20rpx;
  flex-shrink: 0;
}

.group-badge.active {
  color: #44BF72;
  background: #DDF4E4;
}

.group-badge.calm {
  color: #258DE9;
  background: #EFF8FF;
}

.row-arrow {
  width: 34rpx;
  height: 34rpx;
  color: #5E6269;
  flex-shrink: 0;
}

.discover-button {
  margin-top: 40rpx;
  height: 108rpx;
  border: 1rpx solid #8AC5F7;
  border-radius: 36rpx;
  color: #1689F2;
  background: #EAF6FF;
  font-size: 30rpx;
  line-height: 1;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.discover-button .lucide-icon {
  width: 31rpx;
  height: 31rpx;
}

.discover-modal-mask {
  position: fixed;
  z-index: 1000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 32rpx;
  background: rgba(17, 17, 17, 0.46);
  display: flex;
  align-items: center;
  justify-content: center;
}

.discover-modal {
  box-sizing: border-box;
  position: relative;
  width: 100%;
  max-width: 620rpx;
  padding: 48rpx 36rpx 36rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 18rpx 54rpx rgba(17, 17, 17, 0.18);
}

.discover-modal-close {
  position: absolute;
  top: 18rpx;
  right: 20rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  color: #5E6269;
  background: transparent;
  font-size: 46rpx;
  line-height: 1;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-button::after {
  border: 0;
}

.discover-modal-title {
  padding-right: 48rpx;
  color: #111111;
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 900;
}

.discover-modal-input {
  box-sizing: border-box;
  width: 100%;
  height: 92rpx;
  margin-top: 34rpx;
  padding: 0 26rpx;
  border: 1rpx solid #DADDE2;
  border-radius: 22rpx;
  color: #111111;
  background: #F8F9FA;
  font-size: 28rpx;
}

.discover-modal-placeholder {
  color: #9A9EA5;
}

.search-results {
  max-height: 360rpx;
  margin-top: 22rpx;
  border-top: 1rpx solid #ECEEF1;
}

.search-result-item {
  min-height: 106rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #ECEEF1;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.search-result-info {
  min-width: 0;
  flex: 1;
}

.search-result-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #111111;
  font-size: 27rpx;
  line-height: 1.3;
  font-weight: 800;
}

.search-result-number {
  margin-top: 8rpx;
  color: #7B8088;
  font-size: 23rpx;
  line-height: 1.2;
}

.result-apply-button {
  width: 100rpx;
  height: 52rpx;
  margin-left: auto;
  border-radius: 16rpx;
  color: #1689F2;
  background: #EAF6FF;
  font-size: 23rpx;
  line-height: 1;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-grow: 0;
  flex-shrink: 0;
}

.result-apply-button.disabled {
  color: #969BA3;
  background: #ECEEF1;
}

.search-status {
  padding: 34rpx 0 8rpx;
  color: #7B8088;
  text-align: center;
  font-size: 25rpx;
}

.discover-modal-actions {
  margin-top: 34rpx;
  display: flex;
  gap: 20rpx;
}

.modal-button {
  flex: 1;
  height: 84rpx;
  margin: 0;
  border-radius: 22rpx;
  font-size: 28rpx;
  line-height: 84rpx;
  font-weight: 800;
}

.cancel-button {
  border: 1rpx solid #DADDE2;
  color: #5E6269;
  background: #FFFFFF;
}

.apply-button {
  color: #FFFFFF;
  background: #1689F2;
}
