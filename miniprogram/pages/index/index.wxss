.group-page {
  min-height: 100vh;
  padding: 32rpx 28rpx 156rpx;
  padding-top: calc(32rpx + env(safe-area-inset-top));
  background: #FFFFFF;
  color: #111111;
}

.home-header {
  padding: 18rpx 0 42rpx;
}

.title {
  font-size: 48rpx;
  line-height: 1;
  font-weight: 900;
}

.section {
  margin-top: 0;
}

.rank-section {
  margin-top: 42rpx;
}

.section-head {
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 30rpx;
  line-height: 1;
  font-weight: 900;
}

.section-title.with-icon {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.all-button {
  color: #5E6269;
  font-size: 25rpx;
  line-height: 1;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.text-button-icon {
  width: 25rpx;
  height: 25rpx;
}

.section-note {
  color: #5E6269;
  font-size: 25rpx;
  line-height: 1;
  font-weight: 600;
}

.trophy-icon {
  width: 32rpx;
  height: 32rpx;
  color: #D9B300;
}

.group-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.group-card {
  min-height: 158rpx;
  padding: 28rpx 30rpx;
  border: 1rpx solid #DADDE2;
  border-radius: 38rpx;
  background: #F8F9FA;
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.group-icon {
  width: 94rpx;
  height: 94rpx;
  border-radius: 34rpx;
  display: grid;
  place-items: center;
  flex-shrink: 0;
}

.group-icon .lucide-icon {
  width: 42rpx;
  height: 42rpx;
}

.group-icon.energy {
  color: #F06F38;
  background: #FBE2D8;
}

.group-icon.cool {
  color: #258DE9;
  background: #DCEFFC;
}

.group-icon.vital {
  color: #44BF72;
  background: #DDF4E4;
}

.group-main {
  min-width: 0;
  flex: 1;
}

.group-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
  line-height: 1.18;
  font-weight: 900;
}

.group-meta {
  margin-top: 13rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #5E6269;
  font-size: 25rpx;
  line-height: 1;
  font-weight: 600;
}

.group-badge {
  max-width: 220rpx;
  padding: 7rpx 14rpx;
  border-radius: 20rpx;
  border: 1rpx solid currentColor;
  display: flex;
  align-items: center;
  gap: 5rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 21rpx;
  line-height: 1.1;
  font-weight: 900;
}

.badge-icon {
  width: 20rpx;
  height: 20rpx;
  flex-shrink: 0;
}

.group-badge.active {
  color: #44BF72;
  background: #DDF4E4;
}

.group-badge.calm {
  color: #258DE9;
  background: #EFF8FF;
}

.row-arrow {
  width: 34rpx;
  height: 34rpx;
  color: #5E6269;
  flex-shrink: 0;
}

.rank-card {
  overflow: hidden;
  border: 1rpx solid #DADDE2;
  border-radius: 34rpx;
  background: #FFFFFF;
}

.rank-row {
  min-height: 116rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #DADDE2;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.rank-row:last-child {
  border-bottom: 0;
}

.rank-row.is-me {
  position: relative;
  background: #FEF1EB;
}

.rank-row.is-me::before {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 5rpx;
  background: #F06F38;
  content: "";
}

.rank-medal {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: #5E6269;
  font-size: 23rpx;
  line-height: 1;
  font-weight: 900;
  flex-shrink: 0;
}

.rank-medal.gold {
  color: #111111;
  background: #E7C900;
}

.rank-medal.silver {
  color: #111111;
  background: #C3C7CD;
}

.rank-medal.bronze {
  color: #111111;
  background: #D07943;
}

.avatar-letter {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: #111111;
  background: #F1F2F5;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 900;
  flex-shrink: 0;
}

.avatar-letter.me {
  color: #FFFFFF;
  background: #E26424;
}

.rank-main {
  min-width: 0;
  flex: 1;
}

.rank-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 26rpx;
  line-height: 1.15;
  font-weight: 900;
}

.rank-row.is-me .rank-name,
.rank-row.is-me .rank-score {
  color: #E26424;
}

.rank-streak {
  margin-top: 6rpx;
  color: #5E6269;
  font-size: 22rpx;
  line-height: 1.15;
  font-weight: 600;
}

.rank-score {
  color: #111111;
  font-size: 30rpx;
  line-height: 1;
  font-weight: 900;
}

.discover-button {
  margin-top: 40rpx;
  height: 108rpx;
  border: 1rpx solid #8AC5F7;
  border-radius: 36rpx;
  color: #1689F2;
  background: #EAF6FF;
  font-size: 30rpx;
  line-height: 1;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.discover-button .lucide-icon {
  width: 31rpx;
  height: 31rpx;
}
