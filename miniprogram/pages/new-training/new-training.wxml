<view class="new-training-page">
  <view class="detail-back-button" bindtap="onBackTap" role="button" aria-label="返回">‹</view>

  <view class="top-row {{isTemplateMode ? 'template-mode' : ''}}">
    <input
      wx:if="{{!isTemplateMode}}"
      class="timer"
      value="{{timer}}"
      placeholder="00:00"
      placeholder-class="timer-placeholder"
      disabled="{{readonly}}"
      bindfocus="onTimerFocus"
      bindinput="onTimerInput"
      bindblur="onTimerBlur"
    />
    <view wx:if="{{isGroupTemplate}}" class="finish-button group-copy-button" bindtap="onCopyGroupTemplateTap">{{copying ? '复制中' : '复制模板'}}</view>
    <view wx:elif="{{!readonly}}" class="finish-button" bindtap="onFinishTap">{{saving ? '保存中' : (isTemplateMode ? '保存' : '完成')}}</view>
    <view wx:if="{{readonly && !isTemplateMode}}" class="training-delete-button {{deleting || loading ? 'disabled' : ''}}" bindtap="onTrainingDeleteTap" aria-label="删除记录">
      <view class="delete-icon training-delete-icon"></view>
    </view>
  </view>

  <view class="title-row {{readonly ? 'readonly' : ''}} {{isTemplateMode ? 'template-mode' : ''}}">
    <view wx:if="{{!readonly}}" class="pen-icon"></view>
    <view class="title-content">
      <input
        class="title-input"
        value="{{title}}"
        placeholder="{{isTemplateMode ? '点击输入模板名称' : '点击输入训练标题'}}"
        placeholder-class="title-placeholder"
        disabled="{{readonly}}"
        bindinput="onTitleInput"
      />
      <view wx:if="{{readonly && recordedAt}}" class="recorded-at">记录于 {{recordedAt}}</view>
    </view>
    <view wx:if="{{isTemplateMode}}" class="template-action-count">{{actions.length}} 个动作</view>
  </view>

  <view wx:if="{{actions.length && !isTemplateMode}}" class="training-summary">
    <view>{{summary.setText}}　{{summary.actionText}}</view>
    <view>{{summary.volumeText}}</view>
  </view>

  <view class="action-panel {{actions.length ? 'has-actions' : ''}} {{isTemplateMode ? 'template-mode' : ''}}">
    <scroll-view wx:if="{{actions.length}}" class="training-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="training-list">
        <view class="training-card {{item.expanded ? 'expanded' : ''}}" wx:for="{{actions}}" wx:key="uid">
          <view class="training-header" bindtap="onActionCardTap" data-index="{{index}}">
            <image class="training-image" src="{{item.iconPath}}" mode="aspectFit"></image>
            <view class="training-main">
              <view class="training-name">{{item.name}}</view>
              <view class="training-meta">{{isTemplateMode ? item.templateMetaText : item.metaText}}</view>
            </view>
            <view class="training-side">
              <view wx:if="{{!readonly}}" class="delete-button" catchtap="onActionDeleteTap" data-index="{{index}}" data-name="{{item.name}}" role="button" aria-label="删除动作">
                <view class="delete-icon"></view>
              </view>
            </view>
          </view>

          <view wx:if="{{item.expanded}}" class="training-detail">
            <view wx:if="{{item.isCardio}}" class="duration-editor">
              <view class="duration-title">运动时长</view>
              <view wx:if="{{readonly}}" class="duration-readonly">
                <text class="duration-readonly-number">{{item.durationPickerValue[0]}}</text>
                <text class="duration-readonly-unit">小时</text>
                <text class="duration-readonly-number">{{item.durationPickerValue[1]}}</text>
                <text class="duration-readonly-unit">分钟</text>
              </view>
              <picker-view
                wx:else
                class="duration-picker"
                value="{{item.durationPickerValue}}"
                indicator-style="height: 88rpx; border-top: 2rpx solid #F2D0C2; border-bottom: 2rpx solid #F2D0C2; border-radius: 18rpx; background: rgba(255,247,243,.55);"
                mask-style="background: linear-gradient(180deg, #fff 0%, rgba(255,255,255,.35) 36%, rgba(255,255,255,.35) 64%, #fff 100%);"
                bindchange="onDurationChange"
                data-index="{{index}}"
              >
                <picker-view-column>
                  <view class="duration-option" wx:for="{{hourOptions}}" wx:for-item="hour" wx:key="*this">
                    <text class="duration-number">{{hour}}</text><text class="duration-unit">小时</text>
                  </view>
                </picker-view-column>
                <picker-view-column>
                  <view class="duration-option" wx:for="{{minuteOptions}}" wx:for-item="minute" wx:key="*this">
                    <text class="duration-number">{{minute}}</text><text class="duration-unit">分钟</text>
                  </view>
                </picker-view-column>
              </picker-view>
              <button wx:if="{{!isTemplateMode}}" class="cardio-status {{item.sets[0].completed ? 'completed' : ''}} {{readonly ? 'readonly' : ''}}" catchtap="onSetStatusTap" data-action-index="{{index}}" data-set-index="0">
                {{item.sets[0].completed ? '已完成' : '标记完成'}}
              </button>
            </view>
            <view wx:else class="set-list">
              <view class="set-row" wx:for="{{item.sets}}" wx:for-item="set" wx:for-index="setIndex" wx:key="uid">
                <view class="set-number">{{setIndex + 1}}</view>
                <view class="set-field">
                  <text class="set-unit">kg</text>
                  <input class="set-input" type="digit" value="{{set.weight}}" placeholder="{{set.weightEditing ? '' : '0'}}" disabled="{{readonly}}" data-action-index="{{index}}" data-set-index="{{setIndex}}" data-field="weight" bindfocus="onSetInputFocus" bindinput="onSetInput" bindblur="onSetInputBlur" />
                </view>
                <view class="set-field">
                  <text class="set-unit">次</text>
                  <input class="set-input" type="number" value="{{set.reps}}" placeholder="{{set.repsEditing ? '' : '0'}}" disabled="{{readonly}}" data-action-index="{{index}}" data-set-index="{{setIndex}}" data-field="reps" bindfocus="onSetInputFocus" bindinput="onSetInput" bindblur="onSetInputBlur" />
                </view>
                <button wx:if="{{!isTemplateMode}}" class="set-status {{set.completed ? 'completed' : ''}} {{readonly ? 'readonly' : ''}}" catchtap="onSetStatusTap" data-action-index="{{index}}" data-set-index="{{setIndex}}" aria-label="完成状态">
                  <view class="set-status-icon {{set.completed ? 'is-check' : 'is-cross'}}"></view>
                </button>
                <view wx:if="{{!readonly}}" class="set-delete" catchtap="onSetDeleteTap" data-action-index="{{index}}" data-set-index="{{setIndex}}" role="button" aria-label="删除本组">
                  <view class="delete-icon set-delete-icon"></view>
                </view>
              </view>
            </view>
            <button wx:if="{{!readonly && !item.isCardio}}" class="add-set-button" catchtap="onAddSetTap" data-index="{{index}}">
              <text class="add-set-icon">＋</text><text>新增一组</text>
            </button>
          </view>
        </view>
      </view>
    </scroll-view>

    <view wx:if="{{!readonly}}" class="panel-add {{actions.length ? 'with-list' : ''}} {{isTemplateMode ? 'template-mode' : ''}} {{templateId ? 'with-template-actions' : ''}}">
      <button class="add-action" bindtap="onAddActionTap">
        <view class="add-icon">+</view>
        <view class="add-label">加动作</view>
      </button>
      <button wx:if="{{templateId}}" class="template-action-button" bindtap="onUseTemplateTap">
        <view class="template-action-icon train-icon"><view class="lucide-icon icon-zap"></view></view>
        <text class="template-action-label">去训练</text>
      </button>
      <button wx:if="{{templateId}}" class="template-action-button" bindtap="onTemplateDeleteTap">
        <view class="template-action-icon delete-icon-wrap"><view class="delete-icon template-delete-icon"></view></view>
        <text class="template-action-label">删除</text>
      </button>
    </view>
  </view>
</view>
