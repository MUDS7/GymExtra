.new-training-page {
  min-height: 100vh;
  padding: calc(180rpx + env(safe-area-inset-top)) 0 0;
  color: #2B2B2B;
  background: #F4F4F5;
}

.top-row {
  height: 72rpx;
  padding: 0 34rpx 0 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.timer {
  width: 210rpx;
  height: 72rpx;
  color: #E26424;
  font-size: 58rpx;
  line-height: 72rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.timer-placeholder {
  color: #E26424;
}

.finish-button {
  width: 92rpx;
  height: 52rpx;
  border-radius: 26rpx;
  color: #FFFFFF;
  background: #E26424;
  font-size: 27rpx;
  line-height: 52rpx;
  font-weight: 700;
  text-align: center;
}

.title-row {
  height: 92rpx;
  margin-top: 34rpx;
  padding: 0 42rpx;
  display: grid;
  grid-template-columns: 32rpx minmax(0, 1fr);
  align-items: center;
  column-gap: 18rpx;
}

.title-row.readonly {
  grid-template-columns: minmax(0, 1fr);
}

.title-content {
  min-width: 0;
}

.recorded-at {
  margin-top: -2rpx;
  color: #929297;
  font-size: 23rpx;
  line-height: 1.4;
}

.pen-icon {
  width: 28rpx;
  height: 28rpx;
  background: #444444;
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23000%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M12%2020h9%22/%3E%3Cpath%20d%3D%22M16.5%203.5a2.12%202.12%200%200%201%203%203L7%2019l-4%201%201-4Z%22/%3E%3C/svg%3E");
  mask-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23000%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M12%2020h9%22/%3E%3Cpath%20d%3D%22M16.5%203.5a2.12%202.12%200%200%201%203%203L7%2019l-4%201%201-4Z%22/%3E%3C/svg%3E");
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: contain;
  mask-size: contain;
}

.title-input {
  width: 100%;
  height: 56rpx;
  min-width: 0;
  color: #2B2B2B;
  font-size: 28rpx;
  line-height: 56rpx;
}

.title-placeholder {
  color: #9A9A9A;
}

.training-summary {
  min-height: 62rpx;
  margin-top: -8rpx;
  padding: 0 42rpx 10rpx 0;
  color: #2F2F34;
  font-size: 25rpx;
  line-height: 1.45;
  font-weight: 500;
  text-align: right;
}

.action-panel {
  height: calc(100vh - 326rpx - env(safe-area-inset-top));
  margin-top: 16rpx;
  padding-bottom: calc(70rpx + env(safe-area-inset-bottom));
  border-radius: 48rpx 48rpx 0 0;
  background: #F4F4F5;
  box-shadow: 0 -18rpx 52rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: flex-end;
}

.action-panel.has-actions {
  height: calc(100vh - 388rpx - env(safe-area-inset-top));
  justify-content: flex-start;
}

.training-scroll {
  flex: 1;
  width: 100%;
  min-height: 0;
}

.training-list {
  padding: 32rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.training-card {
  width: 100%;
  min-height: 178rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  overflow: hidden;
}

.training-header {
  min-height: 178rpx;
  padding: 28rpx 28rpx 26rpx;
  display: grid;
  grid-template-columns: 132rpx minmax(0, 1fr) 58rpx;
  align-items: center;
  column-gap: 24rpx;
}

.training-card.expanded .training-header {
  border-bottom: 1rpx solid #F0F0F2;
}

.training-image {
  width: 132rpx;
  height: 112rpx;
}

.training-main {
  min-width: 0;
}

.training-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #111111;
  font-size: 32rpx;
  line-height: 1.2;
  font-weight: 700;
}

.training-meta {
  margin-top: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #A0A0A5;
  font-size: 25rpx;
  line-height: 1;
}

.training-side {
  width: 58rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.delete-button {
  width: 54rpx;
  height: 54rpx;
  margin: 0;
  display: grid;
  place-items: center;
}

.delete-icon {
  width: 38rpx;
  height: 38rpx;
  background: #D93025;
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23000%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M3%206h18%22/%3E%3Cpath%20d%3D%22M8%206V4c0-.7.3-1%201-1h6c.7%200%201%20.3%201%201v2%22/%3E%3Cpath%20d%3D%22M19%206l-1%2014c-.1.6-.5%201-1.1%201H7.1c-.6%200-1-.4-1.1-1L5%206%22/%3E%3Cpath%20d%3D%22M10%2011v6%22/%3E%3Cpath%20d%3D%22M14%2011v6%22/%3E%3C/svg%3E");
  mask-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23000%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M3%206h18%22/%3E%3Cpath%20d%3D%22M8%206V4c0-.7.3-1%201-1h6c.7%200%201%20.3%201%201v2%22/%3E%3Cpath%20d%3D%22M19%206l-1%2014c-.1.6-.5%201-1.1%201H7.1c-.6%200-1-.4-1.1-1L5%206%22/%3E%3Cpath%20d%3D%22M10%2011v6%22/%3E%3Cpath%20d%3D%22M14%2011v6%22/%3E%3C/svg%3E");
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: contain;
  mask-size: contain;
}

.training-detail {
  width: 100%;
  padding: 28rpx 24rpx;
  overflow: hidden;
}

.duration-editor {
  padding: 0 16rpx 8rpx;
}

.duration-title {
  color: #8C8C91;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}

.duration-picker {
  position: relative;
  width: 100%;
  height: 264rpx;
  margin-top: 6rpx;
}

.duration-option {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #252529;
}

.duration-number {
  font-size: 42rpx;
  line-height: 88rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.duration-unit {
  color: #8B6A5B;
  font-size: 23rpx;
}

.cardio-status {
  width: 100%;
  height: 72rpx;
  margin: 8rpx 0 0;
  border-radius: 20rpx;
  color: #E26424;
  background: #FFF3EE;
  font-size: 26rpx;
  line-height: 72rpx;
  font-weight: 700;
}

.cardio-status.completed {
  color: #FFFFFF;
  background: #E26424;
}

.cardio-status.readonly {
  pointer-events: none;
}

.set-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.set-row {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.set-number {
  flex: 0 0 54rpx;
  width: 54rpx;
  height: 86rpx;
  border-radius: 18rpx;
  color: #68686D;
  background: #F2F2F4;
  font-size: 26rpx;
  line-height: 86rpx;
  font-weight: 700;
  text-align: center;
}

.set-field {
  position: relative;
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  height: 86rpx;
  border: 2rpx solid #F2D0C2;
  border-radius: 18rpx;
  background: #FFF7F3;
}

.set-unit {
  position: absolute;
  top: 10rpx;
  left: 14rpx;
  z-index: 1;
  color: #B36A49;
  font-size: 19rpx;
  line-height: 1;
}

.set-input {
  display: block;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  height: 100%;
  padding: 0 12rpx;
  color: #26262A;
  font-size: 31rpx;
  line-height: 86rpx;
  font-weight: 700;
  text-align: center;
}

.set-status {
  flex: 0 0 78rpx;
  width: 78rpx;
  min-width: 78rpx;
  height: 86rpx;
  margin: 0;
  border-radius: 18rpx;
  color: #D93025;
  background: #FFF0EE;
  display: flex;
  align-items: center;
  justify-content: center;
}

.set-status.completed {
  color: #FFFFFF;
  background: #E26424;
}

.set-status.readonly {
  pointer-events: none;
}

.set-status-icon {
  position: relative;
  display: block;
  flex: none;
}

.set-status-icon.is-check {
  width: 46rpx;
  height: 38rpx;
}

.set-status-icon.is-check::before,
.set-status-icon.is-check::after {
  content: "";
  position: absolute;
  height: 6rpx;
  border-radius: 4rpx;
  background: #FFFFFF;
  transform-origin: left center;
}

.set-status-icon.is-check::before {
  top: 14rpx;
  left: 3rpx;
  width: 18rpx;
  transform: rotate(45deg);
}

.set-status-icon.is-check::after {
  top: 27rpx;
  left: 15rpx;
  width: 35rpx;
  transform: rotate(-45deg);
}

.set-status-icon.is-cross {
  width: 34rpx;
  height: 34rpx;
}

.set-status-icon.is-cross::before,
.set-status-icon.is-cross::after {
  content: "";
  position: absolute;
  top: 14rpx;
  left: 1rpx;
  width: 32rpx;
  height: 5rpx;
  border-radius: 3rpx;
  background: #D93025;
}

.set-status-icon.is-cross::before {
  transform: rotate(45deg);
}

.set-status-icon.is-cross::after {
  transform: rotate(-45deg);
}

.set-delete {
  flex: 0 0 68rpx;
  width: 68rpx;
  min-width: 68rpx;
  height: 86rpx;
  margin: 0;
  border-radius: 18rpx;
  background: #F6F6F7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.set-delete-icon {
  width: 32rpx;
  height: 32rpx;
}

.add-set-button {
  width: 100%;
  height: 78rpx;
  margin: 28rpx 0 0;
  border-radius: 20rpx;
  color: #E26424;
  background: #FFF3EE;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 27rpx;
  line-height: 78rpx;
  font-weight: 700;
}

.add-set-icon {
  font-size: 34rpx;
  font-weight: 500;
}

.panel-add {
  width: 100%;
  min-height: 170rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.panel-add.with-list {
  min-height: 150rpx;
}

.add-action {
  width: 148rpx;
  height: 126rpx;
  margin: 0;
  color: #5D5D5D;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.add-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  color: #FFFFFF;
  background: #E26424;
  font-size: 46rpx;
  line-height: 54rpx;
  font-weight: 700;
  text-align: center;
}

.add-label {
  font-size: 24rpx;
  line-height: 1;
}
