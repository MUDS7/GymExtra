.attendance-row { margin-top: 26rpx; display: flex; gap: 10rpx; }.attendance-avatar,.avatar-placeholder { position: relative; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #eceff2; color: #c8cbd0; }.attendance-avatar { width: 43rpx; height: 43rpx; border-radius: 50%; }.attendance-avatar.checked { color: #fff; background: #ef671a; }.avatar-head { width: 14rpx; height: 14rpx; border-radius: 50%; background: currentColor; }.avatar-body { width: 25rpx; height: 13rpx; margin-top: 3rpx; border-radius: 14rpx 14rpx 5rpx 5rpx; background: currentColor; }.attendance-text { margin-top: 13rpx; font-size: 21rpx; }
.goal-progress { width: 190rpx; border-left: 1rpx solid #f2d6c5; display: flex; flex-direction: column; align-items: center; justify-content: center; }.ring { width: 108rpx; height: 108rpx; padding: 11rpx; border-radius: 50%; background: conic-gradient(#e95d12 0 62%, #fae5d8 62% 100%); }.ring-inner { width: 100%; height: 100%; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #fff; }.ring-number { font-size: 28rpx; font-weight: 900; }.ring-label { font-size: 18rpx; }.progress-label { margin-top: 13rpx; font-size: 20rpx; }.progress-value { display: flex; align-items: baseline; white-space: nowrap; font-size: 18rpx; }.progress-number { color: #ed5e15; font-size: 26rpx; font-weight: 900; }
.wall { margin-top: 16rpx; padding: 15rpx 20rpx 5rpx; }.section-head { height: 52rpx; display: flex; align-items: center; justify-content: space-between; }.section-title { font-size: 29rpx; font-weight: 900; }.more { color: #626770; font-size: 21rpx; }.member-row { min-height: 66rpx; display: flex; align-items: center; border-bottom: 1rpx solid #edf0f2; }.member-row:last-child { border-bottom: 0; }.member-avatar,.avatar-placeholder { width: 50rpx; height: 50rpx; flex-shrink: 0; border-radius: 50%; }.avatar-placeholder { background: #e7eaed; }.avatar-head.large { width: 15rpx; height: 15rpx; }.avatar-body.large { width: 29rpx; height: 15rpx; }.member-main { flex: 1; min-width: 0; margin-left: 16rpx; }.member-name-line { display: flex; align-items: center; gap: 12rpx; }.member-name { font-size: 23rpx; font-weight: 800; }.member-training { margin-top: 5rpx; color: #555b64; font-size: 19rpx; }.record-tags { display: flex; align-items: center; gap: 8rpx; flex-shrink: 0; }.record-tag { padding: 5rpx 12rpx; border: 1rpx solid; border-radius: 18rpx; flex-shrink: 0; font-size: 21rpx; line-height: 1.1; font-weight: 900; }.record-tag.energy { color: #F06F38; border-color: #F8B08A; background: #FFF3EE; }.record-tag.cool { color: #258DE9; border-color: #8AC5F7; background: #EFF8FF; }.record-tag.incomplete { color: #6F757D; border-color: #D5D8DC; background: #F1F2F4; }.member-state { width: 115rpx; text-align: right; font-size: 21rpx; }.member-state.done { color: #35ad50; }.member-state.rest { color: #7f858e; }.member-state.missed { color: #f05c13; }.state-icon { display: inline-flex; width: 25rpx; height: 25rpx; margin-left: 6rpx; border-radius: 50%; align-items: center; justify-content: center; color: #fff; background: currentColor; font-size: 17rpx; }
.rank-grid { margin-top: 16rpx; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }.rank-card { min-width: 0; padding: 18rpx 16rpx; }.rank-title { display: flex; align-items: center; gap: 6rpx; white-space: nowrap; font-size: 20rpx; font-weight: 800; }.rank-arrow { margin-left: auto; color: #737984; font-size: 30rpx; }.rank-value { margin-top: 16rpx; font-size: 35rpx; font-weight: 900; }.rank-value text { font-size: 20rpx; }.rank-user { margin-top: 8rpx; color: #59606b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 18rpx; }.no-one { float: right; padding: 3rpx 8rpx; border-radius: 9rpx; color: #ef671a; background: #fff0e6; font-weight: 800; }
.rank-grid { align-items: stretch; }.rank-card { position: relative; overflow: hidden; min-height: 146rpx; border: 0; box-shadow: 0 12rpx 28rpx rgba(20, 30, 45, .08); }.rank-card::after { content: ""; position: absolute; right: -28rpx; top: -30rpx; width: 94rpx; height: 94rpx; border-radius: 50%; background: rgba(255,255,255,.52); }.rank-streak { background: linear-gradient(140deg, #fff7ed, #fff1e6); color: #78350f; }.rank-activity { background: linear-gradient(140deg, #edf8ff, #eaf5ff); color: #0f3f66; }.rank-progress { background: linear-gradient(140deg, #f4fff1, #eafbea); color: #14532d; }.rank-streak .rank-value { color: #ea580c; }.rank-activity .rank-value { color: #1d7bd8; }.rank-progress .rank-value { color: #16a34a; }.rank-icon { width: 38rpx; height: 38rpx; flex: 0 0 38rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,.78); font-size: 22rpx; }.rank-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; }.rank-card .rank-arrow { color: currentColor; opacity: .48; }.rank-card .rank-value { margin-top: 18rpx; line-height: 1; letter-spacing: 0; }.rank-card .rank-value text { margin-left: 4rpx; font-weight: 700; opacity: .75; }.rank-card .rank-user { display: flex; align-items: center; gap: 8rpx; color: currentColor; opacity: .78; }.rank-card .rank-user text:first-child { min-width: 0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.rank-chip { flex: 0 0 auto; padding: 3rpx 9rpx; border-radius: 999rpx; background: rgba(255,255,255,.76); font-size: 16rpx; font-weight: 800; opacity: 1; }
