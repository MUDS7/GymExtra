page { background: #fafafa; }
.detail-page { min-height: 100vh; padding-bottom: calc(126rpx + env(safe-area-inset-bottom)); color: #20242c; }
.topbar { min-height: 64rpx; padding: 0 28rpx 18rpx; display: flex; align-items: center; gap: 18rpx; background: #fff; }
.back-button { width: 48rpx; height: 58rpx; display: flex; align-items: center; font-size: 56rpx; line-height: 1; color: #2d3138; }
.page-title { font-size: 44rpx; font-weight: 900; white-space: nowrap; }
.group-picker { min-width: 0; height: 64rpx; padding: 0 22rpx; border: 1rpx solid #e2e5e9; border-radius: 34rpx; display: flex; align-items: center; gap: 10rpx; background: #fff; }
.flame { font-size: 31rpx; }.picker-name { max-width: 190rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 26rpx; }.picker-arrow { margin-left: 4rpx; font-size: 30rpx; }
.content { padding: 16rpx 22rpx 28rpx; }.panel { border: 1rpx solid #e9ebee; border-radius: 28rpx; background: #fff; box-shadow: 0 6rpx 18rpx rgba(21, 27, 38, .04); }
.goal-card { min-height: 224rpx; padding: 24rpx 20rpx; display: flex; border-color: #f4ddcf; background: linear-gradient(105deg, #fffefa, #fff); }.goal-left { flex: 1; min-width: 0; padding-right: 18rpx; }.goal-heading { display: flex; align-items: center; gap: 16rpx; }.medal { width: 66rpx; height: 66rpx; border: 8rpx solid #ff8a34; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; color: #ff8a34; font-size: 42rpx; font-weight: 900; box-shadow: 0 0 0 10rpx #fff0e6; }.goal-title-line { display: flex; align-items: center; gap: 12rpx; }.goal-title { font-size: 29rpx; font-weight: 900; }.goal-slogan { padding: 6rpx 14rpx; border-radius: 20rpx; color: #f16322; background: #fff0e7; font-size: 20rpx; }.goal-copy { margin-top: 12rpx; font-size: 26rpx; }.orange-number { color: #ef6117; font-size: 35rpx; font-weight: 900; }
.attendance-row { margin-top: 26rpx; display: flex; gap: 10rpx; }.attendance-avatar,.avatar-placeholder { position: relative; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #eceff2; color: #c8cbd0; }.attendance-avatar { width: 43rpx; height: 43rpx; border-radius: 50%; }.attendance-avatar.checked { color: #fff; background: #ef671a; }.avatar-head { width: 14rpx; height: 14rpx; border-radius: 50%; background: currentColor; }.avatar-body { width: 25rpx; height: 13rpx; margin-top: 3rpx; border-radius: 14rpx 14rpx 5rpx 5rpx; background: currentColor; }.attendance-text { margin-top: 13rpx; font-size: 21rpx; }
.goal-progress { width: 190rpx; border-left: 1rpx solid #f2d6c5; display: flex; flex-direction: column; align-items: center; justify-content: center; }.ring { width: 108rpx; height: 108rpx; padding: 11rpx; border-radius: 50%; background: conic-gradient(#e95d12 0 62%, #fae5d8 62% 100%); }.ring-inner { width: 100%; height: 100%; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #fff; }.ring-number { font-size: 28rpx; font-weight: 900; }.ring-label { font-size: 18rpx; }.progress-label { margin-top: 13rpx; font-size: 20rpx; }.progress-number { color: #ed5e15; font-size: 31rpx; font-weight: 900; }
.wall { margin-top: 16rpx; padding: 15rpx 20rpx 5rpx; }.section-head { height: 52rpx; display: flex; align-items: center; justify-content: space-between; }.section-title { font-size: 29rpx; font-weight: 900; }.more { color: #626770; font-size: 21rpx; }.member-row { min-height: 66rpx; display: flex; align-items: center; border-bottom: 1rpx solid #edf0f2; }.member-row:last-child { border-bottom: 0; }.avatar-placeholder { width: 50rpx; height: 50rpx; flex-shrink: 0; border-radius: 50%; background: #e7eaed; }.avatar-head.large { width: 15rpx; height: 15rpx; }.avatar-body.large { width: 29rpx; height: 15rpx; }.member-main { flex: 1; min-width: 0; margin-left: 16rpx; }.member-name-line { display: flex; align-items: center; gap: 12rpx; }.member-name { font-size: 23rpx; font-weight: 800; }.member-training { margin-top: 5rpx; color: #555b64; font-size: 19rpx; }.tag { padding: 2rpx 11rpx; border: 1rpx solid; border-radius: 16rpx; font-size: 17rpx; }.tag.orange { color: #ef671a; background: #fff7f1; }.tag.blue { color: #308dec; background: #f1f7ff; }.tag.purple { color: #a44ddd; background: #fbf4ff; }.member-state { width: 115rpx; text-align: right; font-size: 21rpx; }.member-state.done { color: #35ad50; }.member-state.rest { color: #7f858e; }.member-state.missed { color: #f05c13; }.state-icon { display: inline-flex; width: 25rpx; height: 25rpx; margin-left: 6rpx; border-radius: 50%; align-items: center; justify-content: center; color: #fff; background: currentColor; font-size: 17rpx; }
.rank-grid { margin-top: 16rpx; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }.rank-card { min-width: 0; padding: 18rpx 16rpx; }.rank-title { display: flex; align-items: center; gap: 6rpx; white-space: nowrap; font-size: 20rpx; font-weight: 800; }.rank-arrow { margin-left: auto; color: #737984; font-size: 30rpx; }.rank-value { margin-top: 16rpx; font-size: 35rpx; font-weight: 900; }.rank-value text { font-size: 20rpx; }.rank-user { margin-top: 8rpx; color: #59606b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 18rpx; }.no-one { float: right; padding: 3rpx 8rpx; border-radius: 9rpx; color: #ef671a; background: #fff0e6; font-weight: 800; }
.challenge { margin-top: 16rpx; min-height: 117rpx; padding: 18rpx 20rpx; display: flex; align-items: center; }.challenge-copy { flex: 1; min-width: 0; }.challenge-label { font-size: 21rpx; font-weight: 800; }.challenge-label text { margin-left: 8rpx; padding: 3rpx 10rpx; border-radius: 14rpx; color: #38a751; background: #e9f8ec; font-size: 17rpx; }.challenge-title { margin-top: 7rpx; font-size: 29rpx; font-weight: 900; }.challenge-date { margin-top: 5rpx; color: #5e646d; font-size: 18rpx; }.my-progress { width: 215rpx; flex-shrink: 0; color: #505660; font-size: 19rpx; }.my-progress text { margin-left: 10rpx; font-weight: 800; }.progress-dots { margin-top: 15rpx; display: flex; gap: 4rpx; }.progress-dots i { width: 31rpx; height: 12rpx; border-radius: 7rpx; background: #ef6819; }.progress-dots i.off { background: #eceeef; }.check-button { width: 112rpx; height: 52rpx; margin-left: 16rpx; flex: 0 0 112rpx; border-radius: 26rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(135deg, #f17b22, #ef5509); font-size: 21rpx; font-weight: 800; }
.templates { margin-top: 16rpx; padding: 14rpx 20rpx 20rpx; }.template-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx 18rpx; }.template-row { min-width: 0; display: flex; align-items: center; }.template-placeholder { width: 80rpx; height: 80rpx; flex: 0 0 80rpx; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; color: #afb4ba; background: #eef0f2; font-size: 17rpx; }.template-copy { flex: 1; min-width: 0; margin-left: 11rpx; }.template-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 20rpx; font-weight: 800; }.template-meta,.template-used { margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #666c75; font-size: 16rpx; }.copy-button { width: 104rpx; height: 48rpx; margin-left: 8rpx; flex: 0 0 104rpx; border: 1rpx solid #f5d3bf; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; color: #ef6117; background: #fff8f3; white-space: nowrap; font-size: 17rpx; font-weight: 700; }
.fake-tabbar { position: fixed; z-index: 20; left: 0; right: 0; bottom: 0; height: calc(100rpx + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom); border-top: 1rpx solid #e8ebee; display: flex; background: #fff; }.tab-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; color: #64748b; font-size: 20rpx; line-height: 1; }.tab-item.active { color: #e26424; }.tab-icon { width: 48rpx; height: 48rpx; flex-shrink: 0; }
@media (max-width: 350px) { .group-picker { padding: 0 12rpx; }.goal-progress { width: 165rpx; }.template-grid { grid-template-columns: 1fr; } }
