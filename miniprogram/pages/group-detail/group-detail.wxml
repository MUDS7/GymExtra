<view class="detail-page">
  <view class="topbar" style="padding-top: {{headerTop}}px;">
    <view class="back-button" bindtap="onBack" role="button" aria-label="返回">‹</view>
    <view class="page-title">群组</view>
    <text class="group-name">{{groupName}}</text>
  </view>

  <view class="content">
    <view class="goal-card panel" wx:if="{{goal}}">
      <view class="goal-left">
        <view class="goal-heading">
          <view class="medal">☆</view>
          <view>
            <view class="goal-title-line">
              <text class="goal-title">{{goal.title}}</text>
              <text class="goal-slogan">{{goal.slogan}}</text>
            </view>
            <view class="goal-copy">全员累计运动 <text class="orange-number">{{goal.targetValue}}</text> {{goal.unit}}</view>
          </view>
        </view>
        <view class="attendance-row">
          <view wx:for="{{attendance}}" wx:key="index" class="attendance-avatar {{item ? 'checked' : ''}}">
            <view class="avatar-head"></view><view class="avatar-body"></view>
          </view>
        </view>
        <view class="attendance-text">{{goal.checkedInMemberCount}} / {{goal.eligibleMemberCount}} 人已打卡</view>
      </view>
      <view class="goal-progress">
        <view class="ring" style="background: conic-gradient(#e95d12 0 {{goal.percent}}%, #fae5d8 {{goal.percent}}% 100%);"><view class="ring-inner"><text class="ring-number">{{goal.percent}}%</text><text class="ring-label">已完成</text></view></view>
        <view class="progress-label">累计运动</view>
        <view class="progress-value"><text class="progress-number">{{goal.currentValue}}</text><text> / {{goal.targetValue}} {{goal.unit}}</text></view>
      </view>
    </view>

    <view class="wall panel">
      <view class="section-head">
        <text class="section-title">今日训练墙</text>
        <view class="more" bindtap="onActionTap" data-name="全部训练">全部 <text>›</text></view>
      </view>
      <view class="member-row" wx:for="{{members}}" wx:key="id">
        <image wx:if="{{item.avatarUrl}}" class="member-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar-placeholder"><view class="avatar-head large"></view><view class="avatar-body large"></view></view>
        <view class="member-main">
          <view class="member-name-line"><text class="member-name">{{item.name}}</text><text class="tag {{item.tagClass}}">{{item.tag}}</text></view>
          <view class="member-training">{{item.training}} · {{item.duration}} 分钟</view>
        </view>
        <view class="member-state {{item.stateClass}}">{{item.state}} <text class="state-icon">{{item.stateClass === 'done' ? '✓' : item.stateClass === 'missed' ? '!' : '–'}}</text></view>
      </view>
      <view class="empty-state" wx:if="{{!loading && members.length === 0}}">暂无今日训练</view>
    </view>

    <view class="rank-grid" wx:if="{{rankings}}">
      <view class="rank-card rank-streak panel" bindtap="onActionTap" data-name="连续打卡榜">
        <view class="rank-title"><text class="rank-icon">🔥</text><text class="rank-name">连续打卡榜</text><text class="rank-arrow">›</text></view>
        <view class="rank-value">{{rankings.streak.value}} <text>{{rankings.streak.unit}}</text></view>
        <view class="rank-user"><text>@{{rankings.streak.name}}</text><text class="rank-chip">No.1</text></view>
      </view>
      <view class="rank-card rank-activity panel" bindtap="onActionTap" data-name="本周活跃">
        <view class="rank-title"><text class="rank-icon">📈</text><text class="rank-name">本周活跃</text><text class="rank-arrow">›</text></view>
        <view class="rank-value">{{rankings.activity.value}} <text>人</text></view>
        <view class="rank-user"><text>参与率</text><text class="rank-chip">{{rankings.activity.rate}}%</text></view>
      </view>
      <view class="rank-card rank-progress panel" bindtap="onActionTap" data-name="进步榜">
        <view class="rank-title"><text class="rank-icon">🏆</text><text class="rank-name">进步榜</text><text class="rank-arrow">›</text></view>
        <view class="rank-value">{{rankings.progress.value}} <text>{{rankings.progress.unit}}</text></view>
        <view class="rank-user"><text>@{{rankings.progress.name}}</text><text class="rank-chip">今日</text></view>
      </view>
    </view>

    <view class="challenge panel" wx:if="{{challenge}}">
      <view class="challenge-copy"><view class="challenge-label">群挑战 <text>{{challenge.statusText}}</text></view><view class="challenge-title">{{challenge.title}}</view><view class="challenge-date">{{challenge.dateText}}</view></view>
      <view class="my-progress"><view>我的进度 <text>{{challenge.currentValue}} / {{challenge.targetValue}} {{challenge.unit}}</text></view><view class="progress-dots"><i wx:for="{{challenge.progressDots}}" wx:key="index" class="{{item ? '' : 'off'}}"></i></view></view>
      <view class="check-button" bindtap="onActionTap" data-action="checkIn" data-name="去打卡" role="button" aria-label="去打卡">去打卡</view>
    </view>

    <view class="templates panel">
      <view class="section-head"><text class="section-title">训练模板</text><view class="more" bindtap="onActionTap" data-name="全部模板">全部 <text>›</text></view></view>
      <view class="template-grid">
        <view class="template-row" wx:for="{{templates}}" wx:key="id">
          <image wx:if="{{item.imageUrl}}" class="template-image" src="{{item.imageUrl}}" mode="aspectFill"></image>
          <view wx:else class="template-placeholder"><text>图片</text></view>
          <view class="template-copy"><view class="template-name">{{item.name}}</view><view class="template-meta">{{item.duration}} 分钟 · {{item.focus}}</view><view class="template-used">{{item.used}} 人使用</view></view>
          <view class="copy-button" bindtap="onActionTap" data-name="复制模板" role="button" aria-label="复制{{item.name}}">复制模板</view>
        </view>
        <view class="empty-state" wx:if="{{!loading && templates.length === 0}}">暂无训练模板</view>
      </view>
    </view>
  </view>

  <view class="fake-tabbar">
    <view class="tab-item" bindtap="onTabTap" data-url="/pages/train/train">
      <image class="tab-icon" src="/images/icons/lucide/dumbbell-tab.png" mode="aspectFit"></image>
      <text>训练</text>
    </view>
    <view class="tab-item active" bindtap="onTabTap" data-url="/pages/index/index">
      <image class="tab-icon" src="/images/icons/lucide/users-tab-active.png" mode="aspectFit"></image>
      <text>群组</text>
    </view>
    <view class="tab-item" bindtap="onTabTap" data-url="/pages/profile/profile">
      <image class="tab-icon" src="/images/icons/lucide/user-tab.png" mode="aspectFit"></image>
      <text>我的</text>
    </view>
  </view>
</view>
