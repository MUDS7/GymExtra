.login-page {
  min-height: 100vh;
  padding: calc(112rpx + env(safe-area-inset-top)) 48rpx 64rpx;
  color: #111111;
  background: linear-gradient(180deg, #fff5ed 0%, #ffffff 48%);
}

.brand-mark {
  width: 104rpx;
  height: 104rpx;
  border-radius: 32rpx;
  color: #ffffff;
  background: #e26424;
  box-shadow: 0 18rpx 40rpx rgba(226, 100, 36, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  font-weight: 900;
}

.title {
  margin-top: 48rpx;
  font-size: 48rpx;
  line-height: 1.2;
  font-weight: 900;
}

.subtitle {
  margin-top: 18rpx;
  color: #6b6f76;
  font-size: 27rpx;
  line-height: 1.6;
}

.checking {
  margin-top: 96rpx;
  color: #6b6f76;
  text-align: center;
}

.register-card {
  margin-top: 64rpx;
  padding: 48rpx 38rpx 40rpx;
  border: 1rpx solid #e4e4e7;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 24rpx 60rpx rgba(15, 23, 42, 0.08);
}

.avatar-button {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 152rpx;
  height: 152rpx;
  border: 6rpx solid #fff0e8;
  border-radius: 50%;
  background: #f3f4f6;
}

.avatar-hint {
  margin-top: 18rpx;
  color: #e26424;
  font-size: 25rpx;
  font-weight: 700;
}

.field-label {
  margin-top: 46rpx;
  margin-bottom: 16rpx;
  font-size: 27rpx;
  font-weight: 800;
}

.nickname-input {
  height: 92rpx;
  padding: 0 28rpx;
  border: 1rpx solid #daddE2;
  border-radius: 22rpx;
  background: #f9fafb;
  font-size: 29rpx;
}

.submit-button {
  height: 92rpx;
  margin-top: 38rpx;
  border-radius: 46rpx;
  color: #ffffff;
  background: #e26424;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 900;
}

.submit-button[disabled] {
  color: rgba(255, 255, 255, 0.8);
  background: #efa77f;
}

.privacy-note {
  margin-top: 28rpx;
  color: #858990;
  font-size: 22rpx;
  line-height: 1.65;
  text-align: center;
}
