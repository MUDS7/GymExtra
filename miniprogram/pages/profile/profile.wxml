<view class="profile-page">
  <view class="profile-header">
    <view class="page-title">我的</view>
  </view>

  <view class="profile-card" bindtap="onProfileTap" role="button" aria-label="{{isGuest ? '登录或注册' : '编辑资料'}}">
    <view class="avatar-wrap">
      <image wx:if="{{user.avatarUrl}}" class="avatar-letter avatar-image" src="{{user.avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="avatar-letter">{{user.avatar}}</view>
      <view class="avatar-badge">
        <view class="lucide-icon icon-flame"></view>
      </view>
    </view>
    <view class="profile-info">
      <view class="nickname">{{user.nickname}}</view>
      <view class="user-id">ID: {{user.id}}</view>
      <view class="level">
        <view class="lucide-icon icon-zap"></view>
        <text>{{user.level}}</text>
      </view>
    </view>
    <view class="edit-button">{{isGuest ? '登录' : '编辑'}}</view>
  </view>

  <view class="stats-grid">
    <view class="profile-stat {{item.tone}}" wx:for="{{stats}}" wx:key="label">
      <view class="profile-stat-value">{{item.value}}</view>
      <view class="profile-stat-unit">{{item.unit}}</view>
      <view class="profile-stat-label">{{item.label}}</view>
    </view>
  </view>

  <view class="template-section">
    <view class="section-head">
      <view class="section-title">模板</view>
      <view class="all-button" bindtap="onActionTap" data-name="全部模板">
        <text>全部</text>
        <view class="lucide-icon icon-chevron-right"></view>
      </view>
    </view>
    <view class="template-grid">
      <view class="template-item" wx:for="{{templates}}" wx:key="id" bindtap="onActionTap" data-name="{{item.name}}" data-template-id="{{item.id}}">
        <view class="template-icon {{item.tone}}">
          <view class="lucide-icon {{item.icon}}"></view>
        </view>
        <view class="template-name">{{item.name}}</view>
      </view>
    </view>
    <view wx:if="{{templates.length === 0}}" class="template-empty">{{isGuest ? '登录后保存并查看你的训练模板' : '还没有训练模板'}}</view>
  </view>

  <view class="menu-section" wx:for="{{menuGroups}}" wx:for-item="group" wx:key="group">
    <view class="menu-group-title">{{group.group}}</view>
    <view class="menu-card">
      <view class="menu-item" wx:for="{{group.items}}" wx:for-item="entry" wx:key="label" bindtap="onActionTap" data-name="{{entry.label}}">
        <view class="menu-mark {{entry.tone}}">
          <view class="lucide-icon {{entry.icon}}"></view>
        </view>
        <view class="menu-main">
          <view class="menu-title">{{entry.label}}</view>
          <view class="menu-desc" wx:if="{{entry.desc}}">{{entry.desc}}</view>
        </view>
        <view class="lucide-icon icon-chevron-right menu-arrow"></view>
      </view>
    </view>
  </view>
</view>
