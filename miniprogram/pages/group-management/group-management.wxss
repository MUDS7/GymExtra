.management-page {
  min-height: 100vh;
  padding: 48rpx 28rpx 144rpx;
  background: #FFFFFF;
  color: #111111;
}

.page-heading {
  margin-bottom: 40rpx;
}

.page-title {
  font-size: 46rpx;
  line-height: 1.2;
  font-weight: 900;
}

.page-subtitle {
  margin-top: 14rpx;
  color: #6B6F76;
  font-size: 26rpx;
  line-height: 1.4;
}

.group-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.group-card {
  min-height: 166rpx;
  padding: 28rpx;
  border: 1rpx solid #DADDE2;
  border-radius: 32rpx;
  background: #F9FAFB;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.group-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 28rpx;
  display: grid;
  place-items: center;
  flex-shrink: 0;
}

.group-icon .lucide-icon {
  width: 40rpx;
  height: 40rpx;
}

.group-icon.energy { color: #F06F38; background: #FBE2D8; }
.group-icon.cool { color: #258DE9; background: #DCEFFC; }
.group-icon.vital { color: #44BF72; background: #DDF4E4; }

.group-content {
  min-width: 0;
  flex: 1;
}

.group-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.group-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 900;
}

.group-meta {
  margin-top: 12rpx;
  color: #7B8088;
  font-size: 23rpx;
  line-height: 1;
  font-weight: 600;
}

.meta-divider {
  margin: 0 9rpx;
}

.loading-state,
.empty-state {
  padding: 112rpx 24rpx;
  color: #7B8088;
  text-align: center;
  font-size: 27rpx;
}

.empty-icon {
  width: 110rpx;
  height: 110rpx;
  margin: 0 auto 26rpx;
  border-radius: 36rpx;
  color: #258DE9;
  background: #EAF6FF;
  display: grid;
  place-items: center;
}

.empty-icon .lucide-icon {
  width: 52rpx;
  height: 52rpx;
}

.empty-title {
  color: #111111;
  font-size: 31rpx;
  font-weight: 900;
}

.empty-copy {
  margin-top: 14rpx;
  font-size: 25rpx;
}

.create-group-button {
  position: fixed;
  right: 28rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  z-index: 20;
  height: 78rpx;
  margin: 0;
  border-radius: 40rpx;
  color: #FFFFFF;
  background: #258DE9;
  box-shadow: 0 14rpx 34rpx rgba(37, 141, 233, 0.24);
  font-size: 29rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.create-group-button .lucide-icon {
  width: 30rpx;
  height: 30rpx;
}

.create-modal-mask {
  position: fixed;
  z-index: 1000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 32rpx;
  background: rgba(17, 17, 17, 0.46);
  display: flex;
  align-items: center;
  justify-content: center;
}

.create-modal {
  width: 100%;
  max-width: 620rpx;
  padding: 40rpx 36rpx 36rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 18rpx 54rpx rgba(17, 17, 17, 0.18);
}

.create-modal-title {
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 900;
}

.form-label {
  margin-top: 32rpx;
  color: #383C42;
  font-size: 27rpx;
  font-weight: 800;
}

.group-name-input {
  width: 100%;
  height: 90rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  border: 1rpx solid #DADDE2;
  border-radius: 20rpx;
  color: #111111;
  background: #F8F9FA;
  font-size: 28rpx;
}

.input-placeholder {
  color: #9A9EA5;
}

.create-modal-actions {
  margin-top: 36rpx;
  display: flex;
  gap: 20rpx;
}

.modal-button {
  flex: 1;
  height: 84rpx;
  margin: 0;
  border-radius: 22rpx;
  font-size: 28rpx;
  line-height: 84rpx;
  font-weight: 800;
}

.cancel-button {
  border: 1rpx solid #DADDE2;
  color: #5E6269;
  background: #FFFFFF;
}

.confirm-button {
  color: #FFFFFF;
  background: #258DE9;
}
