<view class="action-picker-page">
  <view class="picker-top" style="height: {{headerHeight}}px;">
    <view class="picker-toolbar" style="top: {{toolbarTop}}px;">
      <button class="close-button" bindtap="onCloseTap" aria-label="关闭">
        <view class="close-mark"></view>
      </button>
      <view class="search-box">
        <view class="lucide-icon icon-search search-icon"></view>
        <input
          class="search-input"
          value="{{keyword}}"
          placeholder="输入动作名字搜索"
          placeholder-class="search-placeholder"
          confirm-type="search"
          bindinput="onSearchInput"
        />
      </view>
    </view>
  </view>

  <view class="picker-body" style="height: calc(100vh - {{headerHeight}}px);">
    <scroll-view class="category-rail" scroll-y enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="category-item {{item.id === 'cardio' ? 'category-item-long' : ''}} {{activeCategory === item.id ? 'active' : ''}}"
        bindtap="onCategoryTap"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
      >
        {{item.name}}
      </view>
    </scroll-view>

    <scroll-view class="action-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="action-content">
        <view wx:if="{{activeCategory !== 'back'}}" class="group-title">{{activeCategoryName}}</view>
        <view wx:if="{{activeCategory === 'back' && actions.length}}" class="back-action-groups">
          <block wx:for="{{actionGroups}}" wx:for-item="group" wx:key="id">
            <view class="back-group-title">
              <view class="back-group-line"></view>
              <text>{{group.title}}</text>
              <view class="back-group-line"></view>
            </view>
            <view class="action-grid">
              <view
                wx:for="{{group.actions}}"
                wx:key="id"
                class="action-card"
                bindtap="onActionTap"
                data-id="{{item.id}}"
              >
                <image class="action-image" src="{{item.displayIconPath}}" mode="aspectFit"></image>
                <view class="action-name">{{item.name}}</view>
              </view>
            </view>
          </block>
        </view>
        <view wx:elif="{{actions.length}}" class="action-grid">
          <view
            wx:for="{{actions}}"
            wx:key="id"
            class="action-card {{activeCategory === 'custom' ? 'custom-action-card' : ''}}"
            bindtap="onActionTap"
            bindtouchstart="onCustomActionTouchStart"
            bindtouchend="onCustomActionTouchEnd"
            bindtouchcancel="onCustomActionTouchEnd"
            bindtouchmove="onCustomActionTouchEnd"
            data-id="{{item.id}}"
            data-name="{{item.name}}"
          >
            <image class="action-image" src="{{item.displayIconPath}}" mode="aspectFit"></image>
            <view class="action-name">{{item.name}}</view>
            <view wx:if="{{activeCategory === 'custom'}}" class="custom-action-type {{item.categoryId === 'cardio' ? 'cardio' : 'strength'}}">{{item.categoryId === 'cardio' ? '有氧' : '力量'}}</view>
          </view>
        </view>
        <view wx:else class="empty-state">{{activeCategory === 'custom' ? '还没有自定义动作' : '暂无匹配动作'}}</view>

        <button wx:if="{{activeCategory === 'custom'}}" class="custom-add-button" bindtap="onOpenCustomActionDialog">
          <view class="lucide-icon icon-plus"></view>
          <text>添加自定义动作</text>
        </button>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{showCustomActionDialog}}" class="dialog-mask" catchtap="onCloseCustomActionDialog">
    <view class="custom-action-dialog" catchtap="onCustomActionDialogTap">
      <view class="dialog-title">添加自定义动作</view>
      <view class="dialog-label">动作名称</view>
      <input class="dialog-input" value="{{customActionName}}" maxlength="100" placeholder="例如：壶铃摆动" focus bindinput="onCustomActionNameInput" />
      <view class="dialog-label">动作类型</view>
      <view class="type-options">
        <button class="type-option {{customActionCategory === 'strength' ? 'selected' : ''}}" bindtap="onCustomActionCategoryTap" data-category="strength">力量</button>
        <button class="type-option {{customActionCategory === 'cardio' ? 'selected' : ''}}" bindtap="onCustomActionCategoryTap" data-category="cardio">有氧</button>
      </view>
      <view class="dialog-actions">
        <button class="dialog-cancel" bindtap="onCloseCustomActionDialog">取消</button>
        <button class="dialog-confirm" loading="{{creatingCustomAction}}" bindtap="onCreateCustomAction">添加</button>
      </view>
    </view>
  </view>
</view>
