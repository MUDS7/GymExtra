.action-picker-page {
  width: 100vw;
  min-height: 100vh;
  color: #111111;
  background: #FFFFFF;
  overflow: hidden;
}

.picker-top {
  position: relative;
  width: 100vw;
  background: #FFFFFF;
}

.picker-toolbar {
  position: absolute;
  left: 0;
  right: 0;
  height: 76rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
}

.close-button {
  flex: 0 0 50rpx;
  width: 48rpx;
  height: 48rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-mark {
  position: relative;
  width: 38rpx;
  height: 38rpx;
}

.close-mark::before,
.close-mark::after {
  position: absolute;
  left: 17rpx;
  top: 2rpx;
  content: "";
  width: 5rpx;
  height: 36rpx;
  border-radius: 4rpx;
  background: #0A0A0A;
}

.close-mark::before {
  transform: rotate(45deg);
}

.close-mark::after {
  transform: rotate(-45deg);
}

.search-box {
  flex: 1;
  height: 72rpx;
  width: 0;
  min-width: 0;
  margin-left: 26rpx;
  padding: 0 28rpx;
  border-radius: 36rpx;
  background: #FFFFFF;
  box-shadow: 0 12rpx 40rpx rgba(15, 23, 42, 0.09);
  display: flex;
  align-items: center;
}

.search-icon {
  flex: 0 0 32rpx;
  width: 32rpx;
  height: 32rpx;
  color: #8E8E93;
}

.search-input {
  flex: 1;
  height: 62rpx;
  margin-left: 12rpx;
  min-width: 0;
  color: #111111;
  font-size: 26rpx;
  line-height: 62rpx;
}

.search-placeholder {
  color: #A6A6AA;
}

.picker-body {
  width: 100vw;
  display: flex;
  overflow: hidden;
}

.category-rail {
  flex: 0 0 140rpx;
  width: 140rpx;
  height: 100%;
  background: #F6F6F7;
  box-shadow: 18rpx 0 42rpx rgba(15, 23, 42, 0.06);
}

.category-item {
  position: relative;
  height: 80rpx;
  padding-left: 36rpx;
  color: #757579;
  font-size: 29rpx;
  line-height: 80rpx;
  font-weight: 500;
}

.category-item-long {
  padding-left: 24rpx;
  font-size: 26rpx;
  white-space: nowrap;
}

.category-item.active {
  color: #111111;
  background: #FFFFFF;
  font-weight: 900;
}

.category-item.active::before {
  position: absolute;
  left: 0;
  top: 0;
  content: "";
  width: 6rpx;
  height: 80rpx;
  background: #E26424;
}

.category-item.active::after {
  position: absolute;
  left: 36rpx;
  right: 16rpx;
  bottom: 0;
  content: "";
  height: 1rpx;
  background: #E0E0E0;
}

.action-scroll {
  flex: 1;
  width: 0;
  min-width: 0;
  height: 100%;
  background: #FFFFFF;
}

.action-content {
  min-width: 0;
  padding: 16rpx 20rpx 48rpx 24rpx;
}

.group-title {
  margin: 6rpx 0 26rpx;
  font-size: 37rpx;
  line-height: 1.15;
  font-weight: 900;
}

.back-group-title {
  margin: 6rpx -20rpx 26rpx -24rpx;
  color: #4E5157;
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 800;
  text-align: center;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.back-group-line {
  flex: 1;
  height: 0;
  border-top: 2rpx dashed #A6A6AA;
}

.back-action-groups .action-grid {
  margin-bottom: 18rpx;
}

.action-grid {
  width: 100%;
  min-width: 0;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-content: flex-start;
  align-items: flex-start;
  justify-content: space-between;
  direction: ltr;
}

.action-card {
  flex: 0 0 274rpx;
  align-self: flex-start;
  min-width: 0;
  width: 274rpx;
  height: 264rpx;
  margin: 0 0 24rpx;
  padding: 20rpx 16rpx 24rpx;
  border: 1rpx solid #EFEFEF;
  border-radius: 22rpx;
  background: #FFFFFF;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.action-image {
  width: 176rpx;
  height: 156rpx;
  flex-shrink: 0;
}

.action-name {
  min-width: 0;
  width: 100%;
  margin-top: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #222222;
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 700;
  text-align: center;
}

.custom-action-type {
  margin-top: 10rpx;
  padding: 4rpx 14rpx;
  border-radius: 18rpx;
  color: #E26424;
  background: #FFF1E9;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 800;
}

.custom-action-type.cardio {
  color: #258DE9;
  background: #EFF8FF;
}

.action-card.custom-action-card {
  height: 304rpx;
}

.custom-add-button {
  width: 100%;
  height: 78rpx;
  margin: 12rpx 0 34rpx;
  border-radius: 40rpx;
  color: #FFFFFF;
  background: #E26424;
  box-shadow: 0 14rpx 34rpx rgba(226, 100, 36, 0.24);
  font-size: 29rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.custom-add-button .lucide-icon {
  width: 30rpx;
  height: 30rpx;
}

.dialog-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  padding: 48rpx;
  background: rgba(15, 23, 42, 0.44);
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-action-dialog {
  width: 100%;
  padding: 40rpx 34rpx 32rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 24rpx 60rpx rgba(15, 23, 42, 0.22);
}

.dialog-title {
  margin-bottom: 38rpx;
  color: #111111;
  font-size: 36rpx;
  line-height: 1;
  font-weight: 900;
  text-align: center;
}

.dialog-label {
  margin-bottom: 14rpx;
  color: #4E5157;
  font-size: 25rpx;
  font-weight: 700;
}

.dialog-input {
  width: 100%;
  height: 82rpx;
  margin-bottom: 32rpx;
  padding: 0 24rpx;
  border: 2rpx solid #E3E5E8;
  border-radius: 16rpx;
  color: #111111;
  background: #F8F9FA;
  font-size: 28rpx;
}

.type-options {
  display: flex;
  gap: 18rpx;
}

.type-option {
  flex: 1;
  height: 72rpx;
  margin: 0;
  border: 2rpx solid #E3E5E8;
  border-radius: 16rpx;
  color: #656970;
  background: #FFFFFF;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 68rpx;
}

.type-option.selected {
  border-color: #E26424;
  color: #E26424;
  background: #FFF1E9;
}

.dialog-actions {
  margin-top: 42rpx;
  display: flex;
  gap: 18rpx;
}

.dialog-cancel,
.dialog-confirm {
  flex: 1;
  height: 76rpx;
  margin: 0;
  border-radius: 38rpx;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 76rpx;
}

.dialog-cancel {
  color: #5E6269;
  background: #F0F1F3;
}

.dialog-confirm {
  color: #FFFFFF;
  background: #E26424;
}

@media (max-width: 360px) {
  .picker-toolbar {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }

  .search-box {
    margin-left: 18rpx;
    padding: 0 22rpx;
  }

  .category-rail {
    flex-basis: 124rpx;
    width: 124rpx;
  }

  .category-item {
    padding-left: 30rpx;
    font-size: 27rpx;
  }

  .category-item.active::after {
    left: 30rpx;
  }

  .action-content {
    padding-left: 18rpx;
    padding-right: 16rpx;
  }

  .back-group-title {
    margin-left: -18rpx;
    margin-right: -16rpx;
  }

  .action-grid {
    display: flex;
  }

  .action-card {
    flex-basis: 288rpx;
    width: 288rpx;
    margin-bottom: 20rpx;
    height: 246rpx;
    padding: 18rpx 12rpx 20rpx;
  }

  .action-card.custom-action-card {
    height: 282rpx;
  }

  .action-image {
    width: 150rpx;
    height: 132rpx;
  }

  .action-name {
    font-size: 26rpx;
  }
}

.empty-state {
  margin-top: 160rpx;
  color: #8E8E93;
  font-size: 28rpx;
  text-align: center;
}
