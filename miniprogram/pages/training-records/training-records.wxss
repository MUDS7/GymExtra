.records-page {
  min-height: 100vh;
  padding: 0 28rpx calc(56rpx + env(safe-area-inset-bottom));
  color: #111111;
  background: #FFFFFF;
}

.records-nav {
  position: relative;
  margin: 0 -28rpx 26rpx;
  padding-left: 16rpx;
  padding-right: 16rpx;
  background: #FFFFFF;
}

.records-back {
  position: absolute;
  left: 12rpx;
  z-index: 2;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.records-back-mark {
  width: 24rpx;
  height: 24rpx;
  border-left: 5rpx solid #0A0A0A;
  border-bottom: 5rpx solid #0A0A0A;
  transform: rotate(45deg);
}

.records-nav-title {
  position: absolute;
  left: 160rpx;
  right: 160rpx;
  bottom: 8px;
  overflow: visible;
  color: #111111;
  text-align: center;
  white-space: nowrap;
  font-size: 32rpx;
  font-weight: 500;
}

.day-group + .day-group {
  margin-top: 42rpx;
}

.day-divider {
  margin-bottom: 22rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.day-label {
  color: #8A8E95;
  flex-shrink: 0;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 700;
}

.divider-line {
  height: 1rpx;
  flex: 1;
  background: #E2E4E8;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.record-card {
  min-height: 136rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid #DADDE2;
  border-radius: 36rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.record-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.record-dot.energy {
  background: #F06F38;
}

.record-dot.cool {
  background: #258DE9;
}

.record-dot.incomplete {
  background: #9AA0A8;
}

.record-main {
  min-width: 0;
  flex: 1;
}

.record-title-row {
  display: flex;
  align-items: center;
}

.record-title {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
  line-height: 1.18;
  font-weight: 900;
}

.record-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.record-side {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.record-tag {
  padding: 5rpx 12rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  font-size: 21rpx;
  line-height: 1.1;
  font-weight: 900;
}

.record-tag.energy {
  color: #F06F38;
  border: 1rpx solid #F8B08A;
  background: #FFF3EE;
}

.record-tag.cool {
  color: #258DE9;
  border: 1rpx solid #8AC5F7;
  background: #EFF8FF;
}

.record-tag.incomplete {
  color: #6F757D;
  border: 1rpx solid #D5D8DC;
  background: #F1F2F4;
}

.record-meta {
  margin-top: 12rpx;
  color: #5E6269;
  font-size: 25rpx;
  line-height: 1.2;
  font-weight: 600;
}

.row-arrow {
  width: 34rpx;
  height: 34rpx;
  color: #5E6269;
  flex-shrink: 0;
}

.empty-state,
.loading-state {
  padding: 80rpx 0 40rpx;
  color: #8A8E95;
  text-align: center;
  font-size: 25rpx;
}
