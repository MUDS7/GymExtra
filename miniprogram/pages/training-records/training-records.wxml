<view class="records-page">
  <view class="records-nav" style="height: {{navHeight}}px; padding-top: {{navTop}}px;">
    <button class="records-back" style="top: {{navTop}}px; height: {{navBarHeight}}px; width: {{navBarHeight}}px;" bindtap="onBackTap" aria-label="返回">
      <view class="records-back-mark"></view>
    </button>
    <view class="records-nav-title" style="height: {{navBarHeight}}px; line-height: {{navBarHeight}}px;">{{navTitle}}</view>
  </view>

  <view class="records-toolbar">
    <button class="records-export" size="mini" hover-class="records-export-hover" loading="{{exporting}}" disabled="{{exporting}}" bindtap="onExportTap">导出</button>
  </view>

  <view class="day-group" wx:for="{{groups}}" wx:key="key">
    <view class="day-divider">
      <text class="day-label">{{item.label}}</text>
      <view class="divider-line"></view>
    </view>

    <view class="record-list">
      <view class="record-card" wx:for="{{item.records}}" wx:for-item="record" wx:key="id" bindtap="onRecordTap" data-training-id="{{record.id}}">
        <view class="record-dot {{record.tone}}"></view>
        <view class="record-main">
          <view class="record-title-row">
            <view class="record-title">{{record.name}}</view>
          </view>
          <view class="record-meta">{{record.time}} · {{record.duration}} · {{record.sets}} 组</view>
        </view>
        <view class="record-side">
          <view class="record-tags">
            <view class="record-tag {{tag.tone}}" wx:for="{{record.tags}}" wx:for-item="tag" wx:key="label">{{tag.label}}</view>
          </view>
          <view class="lucide-icon icon-chevron-right row-arrow"></view>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!loading && groups.length === 0}}">暂无训练记录</view>
  <view class="loading-state" wx:if="{{loading}}">加载中...</view>
  <view class="loading-state" wx:if="{{!loading && groups.length > 0 && !hasMore}}">已经到底了</view>
</view>

<view class="export-modal-mask" wx:if="{{showExportModal}}" catchtouchmove="noop">
  <view class="export-modal-backdrop" bindtap="closeExportModal"></view>
  <view class="export-modal" role="dialog" aria-label="导出训练记录">
    <view class="export-modal-header">
      <view class="export-modal-title">导出训练记录</view>
      <button class="export-modal-close" size="mini" bindtap="closeExportModal" aria-label="关闭">×</button>
    </view>
    <view class="export-modal-subtitle">最近 {{exportCount}} 次训练 · 重量单位 kg</view>
    <scroll-view class="export-json-scroll" scroll-y="{{true}}">
      <text class="export-json" selectable="{{true}}">{{exportJson}}</text>
    </scroll-view>
    <view class="export-modal-note">自定义或已移除的动作未提供英文名时，该字段为空。</view>
    <button class="export-copy-button" hover-class="export-copy-hover" bindtap="onCopyExportTap">复制</button>
  </view>
</view>
