{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "envId": "cloud1-d0g045i05d14e02d0",
  "functionRoot": "cloudfunctions",
  "functions": [
    {
      "name": "actionFunctions",
      "runtime": "Nodejs16.13",
      "handler": "index.main",
      "installDependency": true,
      "timeout": 20,
      "memorySize": 256
    }
  ],
  "framework": {
    "plugins": {
      "trainingDatabase": {
        "use": "@cloudbase/framework-plugin-database",
        "inputs": {
          "collections": [
            {
              "collectionName": "trainings",
              "description": "用户训练记录",
              "createIndexes": [
                {
                  "name": "userId_1_createdAt_-1",
                  "unique": false,
                  "keys": [
                    { "name": "userId", "direction": "1" },
                    { "name": "createdAt", "direction": "-1" }
                  ]
                }
              ]
            },
            {
              "collectionName": "user_stats",
              "description": "用户统计数据"
            }
          ]
        }
      }
    }
  }
}
